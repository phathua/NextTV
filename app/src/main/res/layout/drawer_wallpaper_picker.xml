<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A0000000"
    android:clickable="true"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/wallpaperDrawerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/search_bottom_sheet_bg"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Header: Title on Left with Hint, 4 Category Pills & Fullscreen on Right -->
        <RelativeLayout
            android:id="@+id/wallpaperHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wallpaperDrawerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đổi hình nền"
                    android:textColor="#F4F4F5"
                    android:textSize="18sp"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Nhấn chọn để áp dụng • Nhấn giữ OK xem toàn màn hình"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp"
                    android:fontFamily="@string/font_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wallpaperTabsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabCollection"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/search_pill_btn_bg"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Bộ sưu tập"
                    android:textColor="@color/search_pill_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:focusable="true"
                    android:nextFocusUp="@id/tabCollection"
                    android:nextFocusDown="@id/wallpaperRecyclerView"
                    android:nextFocusLeft="@id/tabCollection"
                    android:nextFocusRight="@id/tabPexels" />

                <TextView
                    android:id="@+id/tabPexels"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/search_pill_btn_bg"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Pexels"
                    android:textColor="@color/search_pill_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:focusable="true"
                    android:nextFocusUp="@id/tabPexels"
                    android:nextFocusDown="@id/wallpaperRecyclerView"
                    android:nextFocusLeft="@id/tabCollection"
                    android:nextFocusRight="@id/tabUnsplash" />

                <TextView
                    android:id="@+id/tabUnsplash"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/search_pill_btn_bg"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Unsplash"
                    android:textColor="@color/search_pill_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:focusable="true"
                    android:nextFocusUp="@id/tabUnsplash"
                    android:nextFocusDown="@id/wallpaperRecyclerView"
                    android:nextFocusLeft="@id/tabPexels"
                    android:nextFocusRight="@id/tabPixabay" />

                <TextView
                    android:id="@+id/tabPixabay"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/search_pill_btn_bg"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Pixabay"
                    android:textColor="@color/search_pill_text_color"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:focusable="true"
                    android:nextFocusUp="@id/tabPixabay"
                    android:nextFocusDown="@id/wallpaperRecyclerView"
                    android:nextFocusLeft="@id/tabUnsplash"
                    android:nextFocusRight="@id/btnHeaderFullscreen" />

                <FrameLayout
                    android:id="@+id/btnHeaderFullscreen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/search_pill_btn_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@id/btnHeaderFullscreen"
                    android:nextFocusDown="@id/wallpaperRecyclerView"
                    android:nextFocusLeft="@id/tabPixabay"
                    android:nextFocusRight="@id/btnHeaderFullscreen">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fullscreen_expand"
                        android:tint="@color/search_pill_text_color"
                        android:duplicateParentState="true"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Horizontal Wallpaper List (Height 140dp directly fits thumbnail + internal gradient text + scale) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wallpaperRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:overScrollMode="never"
            android:nextFocusUp="@id/tabCollection"
            android:nextFocusDown="@id/wallpaperRecyclerView" />

    </LinearLayout>
</FrameLayout>
