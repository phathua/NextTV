<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memoryDrawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="true">

    <!-- Left Floating Donut Chart Card (Centered in empty space) -->
    <LinearLayout
        android:id="@+id/containerDonutCard"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_donut_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Donut Ring Chart: 440dp x 300dp -->
        <com.next.tv.launcher.clean.RamDonutChartView
            android:id="@+id/donutChartView"
            android:layout_width="440dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal" />

        <!-- Process Legends Container (Hàng ngang căn giữa) -->
        <LinearLayout
            android:id="@+id/containerLegends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Right Master Container: Sub-panel & Sidebar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false">

        <!-- Sub-panel for Whitelist App Selection (Lưới 2 cột, Header cố định chống che lấp) -->
        <LinearLayout
            android:id="@+id/memorySubPanel"
            android:layout_width="480dp"
            android:layout_height="match_parent"
            android:background="#FC141419"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:focusable="false"
            android:visibility="gone"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants">

            <TextView
                android:id="@+id/tvMemorySubPanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANH SÁCH BẢO VỆ"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:letterSpacing="0.05"
                android:fontFamily="@string/font_medium" />

            <!-- Tab phân loại (Tất cả / Xem phim / Tiện ích) -->
            <LinearLayout
                android:id="@+id/containerSubPanelTabs"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabCategoryAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:gravity="center"
                    android:text="Tất cả"
                    android:textColor="#4ADE80"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tabCategoryMedia"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:gravity="center"
                    android:text="Xem phim"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tabCategoryTools"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:gravity="center"
                    android:text="Tiện ích"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerMemorySubPanelItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="true"
                    android:clipToPadding="true" />
            </ScrollView>
        </LinearLayout>

        <!-- Main Memory Drawer Sidebar (400dp, height 540dp fit) -->
        <ScrollView
            android:id="@+id/memoryDrawerContent"
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:elevation="8dp"
            android:background="#FC141419"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUẢN LÝ BỘ NHỚ"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:letterSpacing="0.04"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tự động tối ưu đa nhiệm TV"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_regular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="6dp"
                    android:background="#27272A" />

                <!-- 1. Dọn dẹp ngay -->
                <LinearLayout
                    android:id="@+id/btnQuickSmartClean"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_clean_ram"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dọn dẹp ngay"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvQuickCleanResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sẵn sàng"
                        android:textColor="#4ADE80"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 2. Chế độ quản lý -->
                <LinearLayout
                    android:id="@+id/itemMemoryMode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_mode_gauge"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chế độ quản lý"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvMemoryModeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tự động"
                        android:textColor="#4ADE80"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Banner giải thích chế độ hoạt động -->
                <TextView
                    android:id="@+id/tvModeDescriptionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#1F2430"
                    android:padding="8dp"
                    android:text="Giữ 6 app hay dùng · Tự dọn khi đầy · Bảo vệ app đang phát"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <!-- 3. Giới hạn ngầm -->
                <LinearLayout
                    android:id="@+id/itemMaxCached"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_layers"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Giới hạn ngầm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvMaxCachedStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 ứng dụng"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 4. Tự động dọn -->
                <LinearLayout
                    android:id="@+id/itemCronInterval"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_timer"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tự động dọn"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvCronIntervalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khi về Home"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 5. Ngưỡng quá tải -->
                <LinearLayout
                    android:id="@+id/itemOverloadThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_ram_alert"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ngưỡng quá tải"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvOverloadThresholdStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="82%"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 6. Giữ app vừa mở -->
                <LinearLayout
                    android:id="@+id/itemRecentGrace"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_history"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Giữ app vừa mở"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvRecentGraceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 phút"
                        android:textColor="#E0E0E0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 7. Bảo vệ phát nhạc & phim -->
                <LinearLayout
                    android:id="@+id/itemProtectMedia"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_media_shield"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bảo vệ phát media"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvProtectMediaStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bật"
                        android:textColor="#4ADE80"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 8. Danh sách bảo vệ (Whitelist) -->
                <LinearLayout
                    android:id="@+id/itemManageWhitelist"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_memory_drawer_item"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_whitelist"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ứng dụng bảo vệ"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_medium" />

                    <TextView
                        android:id="@+id/tvWhitelistCountStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ứng dụng"
                        android:textColor="#A0A0A0"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
