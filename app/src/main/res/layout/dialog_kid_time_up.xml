<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F509090B"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="64dp"
    android:paddingEnd="64dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="true">

    <!-- Left Column: Hero Stage (38%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="38"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/imgCurfewHeroIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_sleep_curfew"
            android:tint="#38BDF8"
            android:contentDescription="@null"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/timeUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đến giờ đi ngủ"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:letterSpacing="0.04"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/timeUpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Đã đến giờ giới nghiêm buổi tối. Bé hãy nghỉ ngơi nhé."
            android:textColor="#A1A1AA"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@string/font_regular" />
    </LinearLayout>

    <!-- Right Column: 3 Action Cards (62%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="62"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Card 1: Gia hạn thêm -->
        <LinearLayout
            android:id="@+id/btnExtendTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="160dp"
            android:background="@drawable/drawer_menu_item_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/iconExtendTime"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_time_extend"
                android:tint="#10B981"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/titleExtendTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gia hạn thêm"
                android:textColor="#F4F4F5"
                android:textSize="15sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/subExtendTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+30 phút"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>

        <!-- Card 2: Thoát chế độ -->
        <LinearLayout
            android:id="@+id/btnExitKidMode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="160dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/drawer_menu_item_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/iconExitKidMode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_mode_unlock"
                android:tint="#E4E4E7"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/titleExitKidMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Thoát chế độ"
                android:textColor="#F4F4F5"
                android:textSize="15sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/subExitKidMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nhập mã PIN"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>

        <!-- Card 3: Nghỉ ngơi -->
        <LinearLayout
            android:id="@+id/btnSleepTv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="160dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/drawer_menu_item_bg"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/iconSleepTv"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_screen_sleep"
                android:tint="#38BDF8"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/titleSleepTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nghỉ ngơi"
                android:textColor="#F4F4F5"
                android:textSize="15sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/subSleepTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tắt màn hình"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
