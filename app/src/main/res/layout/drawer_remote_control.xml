<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remoteControlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="true">

    <!-- Left Area Container (Occupies full space to the left of the 380dp sidebar) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="380dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:clickable="false">

        <LinearLayout
            android:id="@+id/cardWebRemoteQrFloat"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_floating_qr_card"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp"
            android:elevation="12dp"
            android:visibility="gone"
            android:focusable="false"
            android:clickable="true">

            <ImageView
                android:id="@+id/imgWebRemoteQrFloat"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_qr_white"
                android:padding="8dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtWebRemoteUrlFloat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#10B981"
                android:textSize="16sp"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/txtWebRemoteNoteFloat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Quét điều khiển TV"
                android:textColor="#A1A1AA"
                android:textSize="13sp"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>
    </FrameLayout>

    <!-- Right Master Container: Sub-panel & Sidebar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false">

        <!-- Sub-panel for App Selection (380dp) -->
        <LinearLayout
            android:id="@+id/remoteSubPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:background="#F8121215"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:focusable="false"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8121215"
                android:elevation="4dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHỌN ỨNG DỤNG"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Gán phím mở nhanh ứng dụng"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_regular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="#27272A" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:focusable="false">

                <LinearLayout
                    android:id="@+id/containerRemoteSubPanelItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="false" />
            </ScrollView>
        </LinearLayout>

        <!-- Right Drawer Content -->
        <LinearLayout
            android:id="@+id/remoteControlContent"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:elevation="8dp"
            android:background="#F8121318"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:clickable="true"
        android:descendantFocusability="afterDescendants">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="ĐIỀU KHIỂN TV"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:letterSpacing="0.08"
            android:fontFamily="@string/font_medium" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="false">

                <!-- Section 1: Web Remote -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐIỀU KHIỂN QUA WEB"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@string/font_medium" />

                <LinearLayout
                    android:id="@+id/rowWebRemoteToggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/drawer_item_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_web_remote"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Điều khiển Web"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@string/font_regular" />

                    <Switch
                        android:id="@+id/switchWebRemote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false" />
                </LinearLayout>

                <!-- Section 2: Trợ năng hệ thống -->
                <LinearLayout
                    android:id="@+id/containerPermAccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="QUYỀN HỆ THỐNG"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="@string/font_medium" />

                    <LinearLayout
                        android:id="@+id/rowPermAccess"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/drawer_item_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_perm_access"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Dịch vụ trợ năng"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@string/font_regular" />

                        <TextView
                            android:id="@+id/txtBadgeAccess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mở cài đặt"
                            android:textColor="#FFB340"
                            android:textSize="13sp"
                            android:fontFamily="@string/font_medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section 3: Key Remapper -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="GÁN PHÍM REMOTE"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="@string/font_medium" />

                <!-- Container for mapped key actions -->
                <LinearLayout
                    android:id="@+id/containerKeyItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
