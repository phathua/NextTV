<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weatherRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B">

    <!-- Atmospheric Dynamic Background Image -->
    <ImageView
        android:id="@+id/weatherBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Dark Gradient Frosted Scrim Overlay -->
    <View
        android:id="@+id/weatherBgScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim_gradient" />

    <!-- Content Container with 5% TV Overscan Safe Margins -->
    <LinearLayout
        android:id="@+id/weatherContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Bar: Location Pin, Date/Time, and Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin_location"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/weatherCityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FAFAFA"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/weatherConditionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#A1A1AA"
                android:textSize="14sp"
                android:fontFamily="@string/font_regular" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/weatherDateTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:textColor="#71717A"
                android:textSize="14sp"
                android:fontFamily="@string/font_medium" />

            <!-- "Đổi vị trí" Action Button -->
            <TextView
                android:id="@+id/weatherChangeLocationBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/btn_weather_action_bg"
                android:text="Đổi vị trí"
                android:textColor="@color/btn_weather_action_text"
                android:textSize="13sp"
                android:fontFamily="@string/font_medium"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

        <!-- Middle Area: Left Hero Section (45%) & Right 6-Metric Grid (55%) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Left Hero Section -->
            <LinearLayout
                android:id="@+id/weatherHeroContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="45"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginEnd="40dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/heroTempText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="72sp"
                        android:fontFamily="@string/font_medium"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/heroWeatherIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heroConditionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FAFAFA"
                    android:textSize="24sp"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:id="@+id/heroHighLowText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#D4D4D8"
                    android:textSize="15sp"
                    android:fontFamily="@string/font_regular" />

                <TextView
                    android:id="@+id/heroFeelsRainText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#A1A1AA"
                    android:textSize="14sp"
                    android:fontFamily="@string/font_regular" />

            </LinearLayout>

            <!-- Right 6-Metric Frosted Glass Grid -->
            <LinearLayout
                android:id="@+id/weatherMetricsContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="55"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Row 1: Độ ẩm & Tốc độ gió -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Metric 1: Độ ẩm -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/item_weather_metric_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_weather_humidity"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Độ ẩm"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:fontFamily="@string/font_regular" />

                            <TextView
                                android:id="@+id/metricHumidityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FAFAFA"
                                android:textSize="18sp"
                                android:fontFamily="@string/font_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Metric 2: Gió -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/item_weather_metric_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_weather_wind"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tốc độ gió"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:fontFamily="@string/font_regular" />

                            <TextView
                                android:id="@+id/metricWindValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FAFAFA"
                                android:textSize="18sp"
                                android:fontFamily="@string/font_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Áp suất & Chỉ số UV -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- Metric 3: Áp suất -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/item_weather_metric_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_weather_pressure"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Áp suất"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:fontFamily="@string/font_regular" />

                            <TextView
                                android:id="@+id/metricPressureValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FAFAFA"
                                android:textSize="18sp"
                                android:fontFamily="@string/font_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Metric 4: UV Index -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/item_weather_metric_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_weather_uv"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chỉ số UV"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:fontFamily="@string/font_regular" />

                            <TextView
                                android:id="@+id/metricUvValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FAFAFA"
                                android:textSize="18sp"
                                android:fontFamily="@string/font_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Cảm nhận & Xác suất mưa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Metric 5: Nhiệt độ cảm nhận -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/item_weather_metric_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_weather_feels_like"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cảm nhận"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:fontFamily="@string/font_regular" />

                            <TextView
                                android:id="@+id/metricApparentValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FAFAFA"
                                android:textSize="18sp"
                                android:fontFamily="@string/font_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Metric 6: Xác suất mưa -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/item_weather_metric_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_weather_rain_prob"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Khả năng mưa"
                                android:textColor="#71717A"
                                android:textSize="12sp"
                                android:fontFamily="@string/font_regular" />

                            <TextView
                                android:id="@+id/metricRainProbValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FAFAFA"
                                android:textSize="18sp"
                                android:fontFamily="@string/font_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom Area: Horizontal 7-Day Forecast Rail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dự báo 7 ngày"
                    android:textColor="#E4E4E7"
                    android:textSize="16sp"
                    android:fontFamily="@string/font_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Phím Trái / Phải để chuyển ngày"
                    android:textColor="#52525B"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_regular" />
            </LinearLayout>

            <!-- 7 Horizontal Day Cards -->
            <LinearLayout
                android:id="@+id/forecastDaysRow"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:orientation="horizontal"
                android:baselineAligned="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Centered Loading State -->
    <LinearLayout
        android:id="@+id/weatherLoadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Đang tải dữ liệu thời tiết..."
            android:textColor="#A1A1AA"
            android:textSize="14sp"
            android:fontFamily="@string/font_medium" />
    </LinearLayout>

    <!-- Centered Error State (No fake/mock data) -->
    <LinearLayout
        android:id="@+id/weatherErrorContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_weather_cloud"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/weatherErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Không thể tải dữ liệu thời tiết."
            android:textColor="#FAFAFA"
            android:textSize="16sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vui lòng kiểm tra lại kết nối mạng."
            android:textColor="#71717A"
            android:textSize="13sp"
            android:fontFamily="@string/font_regular" />

        <TextView
            android:id="@+id/weatherRetryBtn"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/btn_weather_action_bg"
            android:text="Thử lại"
            android:textColor="@color/btn_weather_action_text"
            android:textSize="14sp"
            android:fontFamily="@string/font_medium"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

</FrameLayout>
