<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetManagerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="true">

    <LinearLayout
        android:id="@+id/widgetManagerContent"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="8dp"
        android:background="#F5121215"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:focusable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants">

        <!-- Top Header -->
        <TextView
            android:id="@+id/tvWidgetManagerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ TIỆN ÍCH"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:letterSpacing="0.08"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/tvWidgetManagerSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tùy chỉnh và mở rộng tiện ích"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:fontFamily="@string/font_regular" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#27272A" />

        <!-- Scrollable Action Items with Padding & Anti-Clipping -->
        <ScrollView
            android:id="@+id/scrollWidgetManager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false">

            <LinearLayout
                android:id="@+id/containerWidgetManagerItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
