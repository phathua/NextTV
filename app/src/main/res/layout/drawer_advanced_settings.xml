<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advancedSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="true">

    <!-- Master Container anchored to the right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false">

        <!-- Left Sub-Panel (Detail: Widgets / Sections Reordering) (380dp) -->
        <LinearLayout
            android:id="@+id/advancedSubPanel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:background="#F8121215"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:focusable="false"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants">

            <TextView
                android:id="@+id/tvSubPanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÙY CHỈNH THIẾT LẬP"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:letterSpacing="0.08"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:id="@+id/tvSubPanelSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bật hoặc tắt tiện ích hiển thị"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:fontFamily="@string/font_regular" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#27272A" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false">

                <LinearLayout
                    android:id="@+id/containerSubPanelItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="false" />
            </ScrollView>
        </LinearLayout>

        <!-- Right Drawer Content (Master: 380dp) -->
        <LinearLayout
            android:id="@+id/advancedSettingsContent"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:elevation="8dp"
            android:background="#F5121215"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            android:focusable="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants">

            <!-- Top Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUẢN TRỊ NÂNG CAO"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:letterSpacing="0.08"
                android:fontFamily="@string/font_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Thiết lập hệ thống &amp; an toàn"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:fontFamily="@string/font_regular" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#27272A" />

            <!-- Scrollable Action Items with Padding & Anti-Clipping -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="false">

                    <!-- 0. Chế độ hoạt động (Mở Panel Phụ bên trái) -->
                    <LinearLayout
                        android:id="@+id/itemUserMode"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/drawer_menu_item_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_mode_tuning"
                            android:tint="@color/drawer_menu_icon_tint"
                            android:duplicateParentState="true"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chế độ hoạt động"
                                android:textSize="14sp"
                                android:fontFamily="@string/font_medium"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_text_color" />

                            <TextView
                                android:id="@+id/tvUserModeStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Đầy đủ"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_subtext_color" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 1. Cài đặt mã PIN -->
                    <LinearLayout
                        android:id="@+id/itemManagePin"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:background="@drawable/drawer_menu_item_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_password_lock"
                            android:tint="@color/drawer_menu_icon_tint"
                            android:duplicateParentState="true"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPinTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cài đặt mã PIN"
                                android:textSize="14sp"
                                android:fontFamily="@string/font_medium"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_text_color" />

                            <TextView
                                android:id="@+id/tvPinStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Bảo vệ cài đặt 4 số"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_subtext_color" />
                        </LinearLayout>
                    </LinearLayout>


                    <!-- 3. Sắp xếp màn hình (Mở Panel Phụ bên trái) -->
                    <LinearLayout
                        android:id="@+id/itemReorderSections"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/drawer_menu_item_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_sort_vertical"
                            android:tint="@color/drawer_menu_icon_tint"
                            android:duplicateParentState="true"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sắp xếp màn hình"
                                android:textSize="14sp"
                                android:fontFamily="@string/font_medium"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_text_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Đổi thứ tự các hàng"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_subtext_color" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 4. Giảm chuyển động (Tiết kiệm RAM) -->
                    <LinearLayout
                        android:id="@+id/itemReducedMotion"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/drawer_menu_item_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_reduced_motion"
                            android:tint="@color/drawer_menu_icon_tint"
                            android:duplicateParentState="true"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Giảm chuyển động"
                                android:textSize="14sp"
                                android:fontFamily="@string/font_medium"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_text_color" />

                            <TextView
                                android:id="@+id/tvReducedMotionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tiết kiệm RAM cho TV yếu"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_subtext_color" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 5. Thông tin thiết bị (Mở Cài đặt Hệ thống Android TV) -->
                    <LinearLayout
                        android:id="@+id/itemDeviceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/drawer_menu_item_bg"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true"
                        android:clickable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="14dp"
                            android:src="@drawable/ic_device_tv"
                            android:tint="@color/drawer_menu_icon_tint"
                            android:duplicateParentState="true"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:duplicateParentState="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thông tin thiết bị"
                                android:textSize="14sp"
                                android:fontFamily="@string/font_medium"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_text_color" />

                            <TextView
                                android:id="@+id/tvDeviceInfoStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Mở cài đặt hệ thống TV"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:duplicateParentState="true"
                                android:textColor="@color/drawer_menu_subtext_color" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
