<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true"
    android:nextFocusUp="@id/tabCollection">

    <!-- 16:9 Thumbnail Frame (220dp x 124dp, bo góc 16dp) -->
    <FrameLayout
        android:id="@+id/wallpaperCardFrame"
        android:layout_width="220dp"
        android:layout_height="124dp"
        android:background="@drawable/search_card_movie_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/wallpaperThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Scrim Gradient overlay at the bottom for text contrast (48dp) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_scrim_news" />

        <!-- Title & Author placed directly inside the card over the gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/wallpaperTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F4F4F5"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/wallpaperAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#D4D4D8"
                android:textSize="10sp"
                android:fontFamily="@string/font_regular"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Focus White Stroke inside the card with clipToOutline -->
        <View
            android:id="@+id/cardFocusStroke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/focus_white_stroke_16dp"
            android:visibility="gone" />

        <!-- Checkmark Badge for Active Wallpaper -->
        <ImageView
            android:id="@+id/imgActiveCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_check_green"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>

</FrameLayout>
