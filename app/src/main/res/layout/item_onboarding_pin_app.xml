<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPinAppRoot"
    android:layout_width="140dp"
    android:layout_height="114dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/wallpaper_card_focus_stroke"
    android:padding="5dp"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_wallpaper_card_inner"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivPinAppIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvPinAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="App"
            android:textColor="#F4F4F5"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinRank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:background="@drawable/badge_perm_granted"
        android:textColor="#22C55E"
        android:textSize="10sp"
        android:fontFamily="@string/font_medium"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivPinCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:src="@drawable/ic_check_green"
        android:visibility="gone"
        android:contentDescription="@null" />

</FrameLayout>
