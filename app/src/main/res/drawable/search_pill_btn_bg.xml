<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: bright contrast, solid pill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F4F4F5" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Selected state (for active category pill): neutral zinc with border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3F3F46" />
            <stroke android:width="1dp" android:color="#71717A" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Activated state -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#3F3F46" />
            <stroke android:width="1dp" android:color="#71717A" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Default / Unfocused state: subtle semi-transparent glass pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF" />
            <stroke android:width="1dp" android:color="#28FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
