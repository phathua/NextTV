<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sideload: Third-party TV media packages queries -->
    <queries>
        <package android:name="com.stremio.one" />
        <package android:name="com.nuvio.tv" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.videomanager" />
    </queries>

    <application>
        <!-- Sideload: Allows system-wide Web browser intents -->
        <activity
            android:name=".browser.WebBrowserActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
